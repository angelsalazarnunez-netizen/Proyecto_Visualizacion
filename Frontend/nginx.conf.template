# Plantilla: al arrancar, nginx reemplaza ${PORT}, ${BACKEND_URL} y ${NGINX_LOCAL_RESOLVERS}
# por las variables de entorno.
server {
    listen ${PORT};
    root /usr/share/nginx/html;

    # Mismo límite de subida que el backend (50MB por solicitud).
    client_max_body_size 50m;

    # Hace lo mismo que el proxy de vite.config.js: /api va al backend.
    # El resolver vuelve a buscar la dirección del backend cada 10 s: en Railway cambia en cada
    # despliegue y sin esto nginx seguiría usando la vieja (error 502).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend ${BACKEND_URL};

    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Las rutas de React Router (BrowserRouter) se resuelven en el navegador.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
